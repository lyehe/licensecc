# licensecc-config.cmake - package configuration file
@PACKAGE_INIT@

set(LCC_ENABLE_DEVICE_IDENTITY "@LCC_ENABLE_DEVICE_IDENTITY@")
set(LCC_ENABLE_LINUX_DESKTOP "@LCC_ENABLE_LINUX_DESKTOP@")
set(LCC_ENABLE_WINDOWS_TPM "@LCC_ENABLE_WINDOWS_TPM@")
set(LCC_ENABLE_TPM2_OPENSSL "@LCC_ENABLE_TPM2_OPENSSL@")
set(LCC_BUILD_DEVICE_IDENTITY_TEST_PROVIDER "@LCC_BUILD_DEVICE_IDENTITY_TEST_PROVIDER@")

get_filename_component(SELF_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
#TODO windows?
set(LCC_PRJ_BASE "${SELF_DIR}/../../licensecc")
set(LCC_FOUND false)

if(licensecc_FIND_COMPONENTS)
	set(_lcc_missing_required "")
	foreach(component ${licensecc_FIND_COMPONENTS})
		set(cmakefile "${LCC_PRJ_BASE}/${component}/cmake/licensecc.cmake")
		if(EXISTS "${cmakefile}")
			include("${cmakefile}")
			set(licensecc_${component}_FOUND TRUE)
			set(LCC_FOUND true)
		else()
			set(licensecc_${component}_FOUND FALSE)
			if(licensecc_FIND_REQUIRED_${component})
				list(APPEND _lcc_missing_required "${component}")
			endif()
		endif()
	endforeach(component)
	if(_lcc_missing_required)
		# Each installed project component is a <name>/cmake/licensecc.cmake below LCC_PRJ_BASE.
		file(GLOB _lcc_component_files RELATIVE "${LCC_PRJ_BASE}" "${LCC_PRJ_BASE}/*/cmake/licensecc.cmake")
		set(_lcc_installed "")
		foreach(_lcc_component_file IN LISTS _lcc_component_files)
			string(REGEX REPLACE "/cmake/licensecc\\.cmake$" "" _lcc_component "${_lcc_component_file}")
			list(APPEND _lcc_installed "${_lcc_component}")
		endforeach()
		list(SORT _lcc_installed)
		if(NOT _lcc_installed)
			set(_lcc_installed "none")
		endif()
		string(REPLACE ";" ", " _lcc_missing_required "${_lcc_missing_required}")
		string(REPLACE ";" ", " _lcc_installed "${_lcc_installed}")
		set(licensecc_NOT_FOUND_MESSAGE
			"Required licensecc component(s) not installed: ${_lcc_missing_required}. Installed components: ${_lcc_installed}.")
		unset(_lcc_component_files)
		unset(_lcc_component_file)
		unset(_lcc_component)
		unset(_lcc_installed)
	endif()
	unset(_lcc_missing_required)
else(licensecc_FIND_COMPONENTS)
	if(LCC_PROJECT_NAME)
		if(EXISTS "${LCC_PRJ_BASE}/${LCC_PROJECT_NAME}/cmake/licensecc.cmake")
			include("${LCC_PRJ_BASE}/${LCC_PROJECT_NAME}/cmake/licensecc.cmake")
			set(licensecc_${LCC_PROJECT_NAME}_FOUND TRUE)
			set(LCC_FOUND true)
		else()
			message( WARNING "Variable LCC_PROJECT_NAME declared but project ${LCC_PROJECT_NAME} not found.")
		endif()
	else(LCC_PROJECT_NAME)
		if(PROJECT_NAME AND (EXISTS "${LCC_PRJ_BASE}/${PROJECT_NAME}/cmake/licensecc.cmake"))
			include("${LCC_PRJ_BASE}/${PROJECT_NAME}/cmake/licensecc.cmake")
			set(licensecc_${PROJECT_NAME}_FOUND TRUE)
		    set(LCC_FOUND true)
		endif()
	endif(LCC_PROJECT_NAME)
endif(licensecc_FIND_COMPONENTS)

if(LCC_FOUND)
    if(LCC_ENABLE_DEVICE_IDENTITY AND CMAKE_SYSTEM_NAME STREQUAL "Linux" AND LCC_ENABLE_LINUX_DESKTOP)
        find_package(CURL 7.85)
        if(NOT CURL_FOUND)
            message(FATAL_ERROR "This licensecc package was built with Linux desktop adapters and needs libcurl >= 7.85 (found: '${CURL_VERSION_STRING}'). Install libcurl >= 7.85 development files or use a package built with LCC_ENABLE_LINUX_DESKTOP=OFF.")
        endif()
    endif()
	get_property(COMPILE_DEF TARGET licensecc::licensecc_static PROPERTY INTERFACE_COMPILE_DEFINITIONS)
	if(LCC_ENABLE_TPM2_OPENSSL)
		set(OPENSSL_USE_STATIC_LIBS ON)
		find_package(OpenSSL 3.0 REQUIRED COMPONENTS Crypto)
	elseif("HAS_OPENSSL" IN_LIST COMPILE_DEF AND NOT OpenSSL_FOUND)
		#message( VERBOSE "Trying to find openssl (required by the target)")
	    SET ( OPENSSL_USE_STATIC_LIBS ON )
	    find_package(OpenSSL 3.0 REQUIRED COMPONENTS Crypto)
	endif()
endif(LCC_FOUND)

check_required_components(licensecc)
