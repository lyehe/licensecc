{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "WebWorker"
    ],
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist-worker"
  },
  "include": [
    "src/worker/groups/catalog/plan_projection.mjs",
    "src/worker/groups/entitlements/policy_store.mjs",
    "src/worker/persistence/idempotency_store.mjs"
  ]
}
