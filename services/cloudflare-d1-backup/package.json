{
  "name": "@licensecc/cloudflare-d1-backup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run generate:wrangler-types && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.mjs",
    "scan:secrets": "node scripts/lint.mjs",
    "lint": "eslint \"src/**/*.{js,mjs,ts,tsx}\" --max-warnings 0",
    "generate:wrangler-types": "wrangler types .wrangler/worker-configuration.d.ts --config wrangler.example.jsonc",
    "typecheck": "npm run generate:wrangler-types && tsc -p tsconfig.typecheck.json --noEmit",
    "dry-run": "npm run build && npx wrangler deploy --dry-run --config wrangler.example.jsonc",
    "validate:deploy": "node scripts/validate-deploy.mjs",
    "time-travel": "node scripts/time-travel.mjs",
    "restore-drill": "node scripts/restore-drill.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3",
    "wrangler": "4.120.0"
  }
}
